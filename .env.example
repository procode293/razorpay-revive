# Razorpay Revive Configuration

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Razorpay Test Credentials (Optional - works in mock mode if blank)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyHere
RAZORPAY_KEY_SECRET=YourTestSecretHere

# LLM Providers (Optional - built-in deterministic heuristic engine is used if blank)
# Free Tier via Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Free Tier via Groq: https://console.groq.com/
GROQ_API_KEY=

# Engine Configuration
DATABASE_URL=sqlite:///./revive_audit.db
ENABLE_MOCK_RAZORPAY=True
DEFAULT_LLM_PROVIDER=heuristic # Options: heuristic, gemini, groq
